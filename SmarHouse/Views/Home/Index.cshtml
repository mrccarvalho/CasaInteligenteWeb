@model SmartHouse.ViewModels.RelatorioVm


@{
    ViewData["Title"] = "Home";
}
<div class="row row-cols-1 row-cols-md-2 mb-3 text-center">
    <div class="col">
        <div class="card mb-4 rounded-3 shadow-sm">
            <div class="card-header py-3">
                <h4 class="my-0 fw-normal">PORTA</h4>
            </div>
            <div class="card-body">
                <h1 class="card-title pricing-card-title"><small class="text-muted fw-light"></small></h1>
                @if (@Model.LastSet.Porta == 0)
                {
                    <img src="~/images/closed.png" />
                }
                else
                {
                    <img src="~/images/open.png" />
                }

                <button type="button" class="w-100 btn btn-lg btn-outline-primary">@Model.LastSet.DateOnlyString - @Model.LastSet.TimeOnlyString</button>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card mb-4 rounded-3 shadow-sm">
            <div class="card-header py-3">
                <h4 class="my-0 fw-normal">LUZ DO JARDIM</h4>
            </div>
            <div class="card-body">
                <h1 class="card-title pricing-card-title"></h1>
                @if (@Model.LastSet.Movimento == 1)
                {
                    <img src="~/images/luz.png" />
                }
                else
                {
                    <img src="~/images/luz-off.png" />
                }
                <button type="button" class="w-100 btn btn-lg btn-primary">@Model.LastSet.DateOnlyString - @Model.LastSet.TimeOnlyString</button>
            </div>
        </div>
    </div>
    
</div>



@section Scripts {

}